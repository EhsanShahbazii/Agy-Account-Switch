{
  "name": "agy-account-switch",
  "version": "1.0.0",
  "description": "Seamless multi-account switcher injected natively into Google Antigravity desktop app for macOS",
  "main": "src/core/accountManager.js",
  "bin": {
    "agy-switch": "./bin/agy-switch.js"
  },
  "scripts": {
